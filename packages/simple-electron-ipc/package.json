{
  "name": "simple-electron-ipc",
  "version": "2.1.0",
  "description": "an easy way to use electron ipc, get a response via promise, event support progress feedback",
  "main": "dist/index.js",
  "module": "dist/index.es.mjs",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "predev": "pnpm build && tsc -p demo/tsconfig.json",
    "dev": "electron ./demo/dist/main.js"
  },
  "files": [
    "dist/*"
  ],
  "keywords": [
    "rpc",
    "duplex",
    "ipc",
    "duplex-message",
    "hub",
    "electron",
    "promise"
  ],
  "dependencies": {
    "duplex-message": "workspace:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "electron": "catalog:"
  },
  "peerDependencies": {
    "electron": "*"
  },
  "repository": "https://oe@github.com/oe/duplex-message.git",
  "author": "Saiya",
  "license": "MIT",
  "homepage": "https://github.com/oe/duplex-message/tree/main/packages/simple-electron-ipc",
  "type": "commonjs",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.mjs",
      "require": "./dist/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  }
}
