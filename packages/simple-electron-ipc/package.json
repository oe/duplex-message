{
  "name": "simple-electron-ipc",
  "version": "2.1.0",
  "description": "Bidirectional Electron RPC with progress feedback, typed calls and local cancellation; use from an isolated preload.",
  "main": "dist/index.js",
  "module": "dist/index.es.mjs",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "build:demo": "tsc -p demo/tsconfig.json && vite build --config demo/vite.config.mts --mode preload && vite build --config demo/vite.config.mts --mode renderer",
    "predev": "pnpm build && pnpm build:demo",
    "dev": "electron ./demo/dist/main.js"
  },
  "files": [
    "dist/*"
  ],
  "keywords": [
    "electron",
    "ipc",
    "rpc",
    "contextbridge",
    "preload",
    "context-isolation",
    "typescript",
    "promise",
    "progress",
    "bidirectional",
    "ipc-main",
    "ipc-renderer"
  ],
  "dependencies": {
    "duplex-message": "workspace:^"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "electron": "catalog:"
  },
  "peerDependencies": {
    "electron": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oe/duplex-message.git",
    "directory": "packages/simple-electron-ipc"
  },
  "author": "Saiya",
  "license": "MIT",
  "homepage": "https://github.com/oe/duplex-message/tree/main/packages/simple-electron-ipc",
  "type": "commonjs",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.mjs",
      "require": "./dist/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  }
}
