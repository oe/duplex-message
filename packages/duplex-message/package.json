{
  "name": "duplex-message",
  "version": "2.1.0",
  "description": "makes one way message responsive, enhance postMessage/storageEvent/chrome extension scripts",
  "main": "dist/index.umd.js",
  "module": "dist/index.es.mjs",
  "scripts": {
    "build": "vite build && vite build --mode production-lib && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "dev": "vite --mode demo",
    "build:demo": "vite build --mode demo",
    "test:coverage": "vitest run --coverage"
  },
  "files": [
    "dist/*"
  ],
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "playwright": "catalog:"
  },
  "keywords": [
    "rpc",
    "duplex",
    "duplex-message",
    "hub",
    "postmessage",
    "promise",
    "iframe",
    "webworker",
    "worker"
  ],
  "repository": "https://oe@github.com/oe/duplex-message.git",
  "author": "Saiya",
  "license": "MIT",
  "homepage": "https://github.com/oe/duplex-message/tree/main/packages/duplex-message",
  "type": "commonjs",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.mjs",
      "require": "./dist/index.cjs"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  }
}
